#!/bin/sh
# Deterministic stand-in for the IUPAC `inchi-1` binary (offline
# specs). Emulates the distributed build's FILE contract:
# `inchi-1 input.mol output.txt [flags]` — reads the V2000 molfile
# from the first argument, writes InChI=/InChIKey= lines to the second
# (flags may follow). Keyed on the counts line (line 4) so the spec
# exercises the real molfile pipe.
#
# Known shapes (values verified against PubChem CIDs 2244 and 702):
#   13 atoms / 13 bonds -> aspirin
#    3 atoms /  2 bonds -> ethanol
#   anything else       -> engine failure (exit 1)
input=$1
output=$2
counts=$(sed -n '4p' "$input")
atoms=$(printf '%s' "$counts" | cut -c1-3 | tr -d ' ')
bonds=$(printf '%s' "$counts" | cut -c4-6 | tr -d ' ')

case "${atoms}_${bonds}" in
  13_13)
    {
      printf 'InChI=1S/C9H8O4/c1-6(10)13-8-5-3-2-4-7(8)9(11)12/h2-5H,1H3,(H,11,12)\n'
      printf 'InChIKey=BSYNRYMUTXBXSQ-UHFFFAOYSA-N\n'
    } > "$output"
    ;;
  3_2)
    {
      printf 'InChI=1S/C2H6O/c1-2-3/h3H,2H2,1H3\n'
      printf 'InChIKey=LFQSCWFLJHTTHZ-UHFFFAOYSA-N\n'
    } > "$output"
    ;;
  *)
    echo "Error: stub-inchi-1 does not know this structure" >&2
    exit 1
    ;;
esac
