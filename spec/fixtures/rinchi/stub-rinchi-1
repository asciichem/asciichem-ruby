#!/bin/sh
# Deterministic stand-in for the IUPAC `rinchi-1` binary (offline
# specs). Emulates the -STDIO -AuxNone -NoLabels -Key contract: reads
# a $RXN reaction file on stdin, writes RInChI= and key lines to
# stdout. Keyed on the counts line (line 5) so the spec exercises the
# real RXN pipe.
#
# Known shape:
#   1 reactant / 1 product  -> canned RInChI
#   anything else           -> engine failure (exit 1)
input=$(cat)
counts=$(printf '%s' "$input" | sed -n '5p')
reactants=$(printf '%s' "$counts" | cut -c1-3 | tr -d ' ')
products=$(printf '%s' "$counts" | cut -c4-6 | tr -d ' ')

case "${reactants}_${products}" in
  1_1)
    printf 'RInChI=1S/C2H6O/c1-2-3/h3H,2H2,1H3!C2H4O/c1-2/h1H2,2H3\n'
    printf 'Short-RInChIKey=SA-FUHFF-UHFFFADPSC-UHFFFAOYSA-N\n'
    printf 'Long-RInChIKey=SA-FUHFF-UHFFFAOYSA-N-UHFFFAOYSA-N\n'
    ;;
  *)
    echo "Error: stub-rinchi-1 does not know this reaction" >&2
    exit 1
    ;;
esac
